<UserControl x:Class="ListenSphere.Controller.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ListenSphere.Controller.Views">
    <Border Background="{StaticResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="68" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Margin="24,14" LastChildFill="True">
                <Button DockPanel.Dock="Left" Command="{Binding ShowDashboardCommand}"
                        AutomationProperties.Name="返回主界面" Content="返回主界面" />
                <TextBlock Margin="20,0,0,0" VerticalAlignment="Center"
                           FontSize="24" FontWeight="SemiBold" Text="设置" />
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="218" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource SidebarBrush}">
                    <StackPanel Margin="16,18">
                        <TextBlock Style="{StaticResource EyebrowText}" Text="设置目录" />
                        <Button Margin="0,10,0,0" Command="{Binding ShowSettingsCommand}"
                                AutomationProperties.Name="软件更新"
                                Background="#1A2638" BorderThickness="0"
                                HorizontalContentAlignment="Left" Content="软件更新" />
                    </StackPanel>
                </Border>

                <views:SoftwareUpdateView Grid.Column="1" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
