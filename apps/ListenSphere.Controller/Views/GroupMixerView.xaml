<UserControl x:Class="ListenSphere.Controller.Views.GroupMixerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Width="500" Margin="0,7,0,0" Padding="15"
            Background="{StaticResource SurfaceRaisedBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1" CornerRadius="11">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="分组混音器" />
                    <TextBlock Margin="0,3,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"
                               Text="分组控制叠加在各声道设置之后，不会改写设备自己的音量和均衡器。" />
                </StackPanel>
                <ToggleButton Grid.Column="1" MinWidth="104" Height="31" Padding="9,0"
                              Style="{StaticResource MuteToggleButton}"
                              IsChecked="{Binding Network.GroupMixer.AutomaticRoutingEnabled, Mode=TwoWay}"
                              Content="自动路由" />
            </Grid>
            <TextBlock Margin="0,5,0,12" Foreground="{StaticResource AccentBrush}" FontSize="10"
                       Text="{Binding Network.GroupMixer.AutomaticRoutingStatus}" />
            <ItemsControl ItemsSource="{Binding Network.GroupMixer.ActiveGroupBuses}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,7" Padding="10,8" Background="#151D27"
                                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="85" />
                                    <ColumnDefinition Width="115" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="38" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding ChannelCountText}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" Height="31" Margin="7,0"
                                          ItemsSource="{Binding EqualizerPresets}"
                                          SelectedItem="{Binding SelectedEqualizerPreset, Mode=TwoWay}"
                                          DisplayMemberPath="Name" />
                                <Slider Grid.Column="2" Margin="8,0" Minimum="0" Maximum="100"
                                        Value="{Binding VolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10"
                                           Text="{Binding VolumePercent, StringFormat={}{0:F0}%}" />
                                <ToggleButton Grid.Column="4" Width="34" Height="31" Margin="4,0,0,0"
                                              Style="{StaticResource MuteToggleButton}"
                                              IsChecked="{Binding IsMuted, Mode=TwoWay}"
                                              ToolTip="{Binding MuteButtonText}">
                                    <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE74F;" />
                                </ToggleButton>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Text="当前没有已连接的远程声道。">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Network.GroupMixer.ActiveGroupBuses.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Border Height="1" Margin="0,10,0,10" Background="{StaticResource StrokeBrush}" />
            <Grid Margin="0,0,0,7">
                <TextBlock FontWeight="SemiBold" Text="已学习路由规则" />
                <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"
                           Text="关闭单条规则不会删除记录" />
            </Grid>
            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Network.GroupMixer.RoutingRules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6" Padding="9,7" Background="#151D27"
                                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="76" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,2,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" Text="{Binding MatchSummary}" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Height="29" Margin="7,0" Padding="7,0"
                                                  Style="{StaticResource MuteToggleButton}"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                  Content="启用" />
                                    <Button Grid.Column="2" Width="32" Height="29" Command="{Binding DeleteCommand}"
                                            Style="{StaticResource IconButton}" ToolTip="删除此路由规则">
                                        <TextBlock Style="{StaticResource IconText}" Foreground="{StaticResource ErrorBrush}" Text="&#xE74D;" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Text="尚未学习规则；在声道调音中修改用途分组即可创建。">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding Network.GroupMixer.RoutingRules.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
