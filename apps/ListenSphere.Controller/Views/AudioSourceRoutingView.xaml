<UserControl x:Class="ListenSphere.Controller.Views.AudioSourceRoutingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ListenSphere.Controller"
             xmlns:views="clr-namespace:ListenSphere.Controller.Views">
<Border Margin="0,0,0,16"
         Padding="14"
         Background="{StaticResource SurfaceSubtleBrush}"
         BorderBrush="Transparent"
         BorderThickness="1"
         CornerRadius="12">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.25*" />
            <ColumnDefinition Width="42" />
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="42" />
            <ColumnDefinition Width="1.25*" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center">
            <Grid Margin="0,0,0,7">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}"
                               Foreground="{StaticResource AccentBrush}"
                               Text="&#xE7F7;" />
                    <TextBlock Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="声音来源" />
                </StackPanel>
                <ToggleButton x:Name="GroupMixerButton"
                              Width="72" Height="28"
                              HorizontalAlignment="Right"
                              Padding="7,0"
                              Style="{StaticResource MuteToggleButton}"
                              IsChecked="{Binding Network.IsGroupMixerOpen, Mode=TwoWay}"
                              ToolTip="打开分组混音器">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" FontSize="13" Foreground="{StaticResource AccentBrush}" Text="&#xE9D2;" />
                        <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" FontSize="10" Text="分组" />
                    </StackPanel>
                </ToggleButton>
                <Popup IsOpen="{Binding Network.IsGroupMixerOpen, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=GroupMixerButton}"
                       Placement="Bottom"
                       HorizontalOffset="-425"
                       StaysOpen="False"
                       AllowsTransparency="True">
                    <views:GroupMixerView />
                </Popup>
            </Grid>
            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid Margin="0,2"
                          Background="Transparent"
                          PreviewMouseLeftButtonDown="LocalSource_PreviewMouseLeftButtonDown"
                          MouseMove="LocalSource_MouseMove"
                          ToolTip="拖动卡片可将 Windows 本地总声音同时输出到其他播放设备">
                        <Border Padding="10,8"
                                Background="#171F29"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="9">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="本地声音" />
                                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Text="进入聆界的本机音源增益" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1"
                                                  Width="36" Height="32"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource MuteToggleButton}"
                                                  IsChecked="{Binding Network.IsLocalSourceMuted, Mode=TwoWay}"
                                                  ToolTip="{Binding Network.LocalSourceMuteButtonText}">
                                        <TextBlock HorizontalAlignment="Center" FontSize="15" Style="{StaticResource IconText}" Text="&#xE74F;" />
                                    </ToggleButton>
                                </Grid>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                                    <Slider Minimum="0"
                                            Maximum="100"
                                            ToolTip="本机音源增益"
                                            Value="{Binding Network.LocalSourceVolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               Text="{Binding Network.LocalSourceVolumePercent, StringFormat={}{0:F0}%}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border IsHitTestVisible="False"
                                BorderBrush="#4C8DFF"
                                BorderThickness="1.25"
                                CacheMode="BitmapCache"
                                CornerRadius="7"
                                Opacity="0.035"
                                local:AudioGlowBehavior.Level="{Binding LocalPeakPercent}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14"
                                                  Color="#3F83FF"
                                                  Direction="0"
                                                  Opacity="0.9"
                                                  ShadowDepth="0" />
                            </Border.Effect>
                        </Border>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Network.ActiveRemoteChannels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2"
                                      Background="Transparent"
                                      PreviewMouseLeftButtonDown="RemoteSource_PreviewMouseLeftButtonDown"
                                      MouseMove="RemoteSource_MouseMove"
                                      ToolTip="{Binding NetworkQualityToolTip}">
                                    <Border Padding="10,8"
                                            Background="#171F29"
                                            BorderBrush="Transparent"
                                            BorderThickness="1"
                                            CornerRadius="9">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="120" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="40" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Margin="0,0,6,0" Style="{StaticResource IconText}" Foreground="{StaticResource AccentBrush}" FontSize="13" Text="{Binding SourceGlyph}" />
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Text="{Binding SourceSubtitle}" />
                                                        <TextBlock Margin="6,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Text="{Binding StatusText}" />
                                                        <TextBlock Margin="6,0,0,0" Foreground="{StaticResource AccentBrush}" FontSize="10" Text="{Binding SelectedChannelGroup}" />
                                                        <TextBlock Margin="6,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" Text="{Binding RoutingStatus}" />
                                                        <TextBlock Margin="6,0,0,0" Foreground="{Binding NetworkQualityColor}" FontSize="9" Text="{Binding NetworkQualityText}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <ToggleButton x:Name="RemoteSourceButton"
                                                              Grid.Column="1"
                                                              MinWidth="96" Height="32"
                                                              Margin="6,0"
                                                              Padding="9,0"
                                                              VerticalAlignment="Center"
                                                              IsChecked="{Binding IsEditorOpen, Mode=TwoWay}"
                                                              Style="{StaticResource MuteToggleButton}"
                                                              ToolTip="打开声道调音">
                                                    <Grid MinWidth="76">
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                                            <TextBlock Style="{StaticResource IconText}" Foreground="{StaticResource AccentBrush}" Text="&#xE9E9;" />
                                                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="10" Text="{Binding SelectedEqualizerPreset.Name}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </ToggleButton>
                                                <ToggleButton Grid.Column="2" Width="36" Height="32" VerticalAlignment="Center" Style="{StaticResource MuteToggleButton}" IsChecked="{Binding IsMuted, Mode=TwoWay}" ToolTip="{Binding MuteButtonText}">
                                                    <TextBlock HorizontalAlignment="Center" FontSize="15" Style="{StaticResource IconText}" Text="&#xE74F;" />
                                                </ToggleButton>
                                                <Button Grid.Column="3" Width="32" Height="32" VerticalAlignment="Center" Command="{Binding DisconnectCommand}" Style="{StaticResource IconButton}" ToolTip="断开连接（保留设备信任）">
                                                    <TextBlock Style="{StaticResource IconText}" Foreground="{StaticResource WarningBrush}" Text="&#xE8BB;" />
                                                </Button>
                                            </Grid>
                                            <Grid Margin="0,7,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,7,0" Orientation="Horizontal">
                                                    <ToggleButton Width="25" Height="25" Style="{StaticResource MuteToggleButton}"
                                                                  IsChecked="{Binding IsPinned, Mode=TwoWay}" ToolTip="固定到声道列表顶部">
                                                        <TextBlock Style="{StaticResource IconText}" FontSize="11" Text="&#xE840;" />
                                                    </ToggleButton>
                                                    <Button Width="23" Height="25" Margin="3,0,0,0" Command="{Binding MoveUpCommand}"
                                                            Style="{StaticResource IconButton}" ToolTip="上移声道">
                                                        <TextBlock Style="{StaticResource IconText}" FontSize="10" Text="&#xE70E;" />
                                                    </Button>
                                                    <Button Width="23" Height="25" Margin="3,0,0,0" Command="{Binding MoveDownCommand}"
                                                            Style="{StaticResource IconButton}" ToolTip="下移声道">
                                                        <TextBlock Style="{StaticResource IconText}" FontSize="10" Text="&#xE70D;" />
                                                    </Button>
                                                </StackPanel>
                                                <Slider Grid.Column="1" Minimum="0" Maximum="100" ToolTip="设备音量" Value="{Binding VolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Text="{Binding VolumePercent, StringFormat={}{0:F0}%}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border IsHitTestVisible="False"
                                            BorderBrush="#4C8DFF"
                                            BorderThickness="1.25"
                                            CacheMode="BitmapCache"
                                            CornerRadius="7"
                                            Opacity="0.035"
                                            local:AudioGlowBehavior.Level="{Binding AudioGlowLevel}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="14"
                                                              Color="#3F83FF"
                                                              Direction="0"
                                                              Opacity="0.9"
                                                              ShadowDepth="0" />
                                        </Border.Effect>
                                    </Border>
                                    <Popup IsOpen="{Binding IsEditorOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=RemoteSourceButton}" Placement="Right" StaysOpen="False" AllowsTransparency="True">
                                        <Border Width="740" Margin="8,0,0,0" Padding="16" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="10">
                                            <StackPanel>
                                                <views:ChannelTuningHeaderView />
                                                <views:ChannelDynamicsView />
                                                <views:ChannelEqualizerView />
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>

        <TextBlock Grid.Column="1"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Style="{StaticResource IconText}"
                   Foreground="{StaticResource MutedBrush}"
                   Text="&#xE76C;" />

        <Grid Grid.Column="2" VerticalAlignment="Center">
            <ToggleButton x:Name="AudioDetailsButton"
                          Padding="12,10"
                          IsChecked="{Binding Network.IsAudioDetailsOpen, Mode=TwoWay}"
                          ToolTip="点击查看完整播放数据">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="HubCard" Padding="{TemplateBinding Padding}" Background="#1B2948" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HubCard" Property="BorderBrush" Value="#5576A8" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="HubCard" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
                <StackPanel HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource SuccessBrush}" />
                        <TextBlock FontWeight="SemiBold" Text="聆界正在汇聚" />
                    </StackPanel>
                    <TextBlock Margin="0,5,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Text="点击查看完整播放数据" />
                </StackPanel>
            </ToggleButton>
            <Popup IsOpen="{Binding Network.IsAudioDetailsOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=AudioDetailsButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                <Border Width="390" Margin="0,8,0,0" Padding="15" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="汇聚与播放详情" />
                        <TextBlock Margin="0,9,0,0" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Network.AudioStatus}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,7,0,0" Foreground="{StaticResource ErrorBrush}" Text="{Binding Network.AudioErrorText}" TextWrapping="Wrap" />
                        <Separator Margin="0,10,0,8" Background="{StaticResource StrokeBrush}" />
                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Text="数据包含接收端口、混音路数、缺帧与丢包状态；点击卡片外部关闭。" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <TextBlock Grid.Column="3"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Style="{StaticResource IconText}"
                   Foreground="{StaticResource MutedBrush}"
                   Text="&#xE76C;" />

        <Grid Grid.Column="4" VerticalAlignment="Center">
             <Grid.RowDefinitions>
                 <RowDefinition Height="Auto" />
                 <RowDefinition Height="Auto" />
                 <RowDefinition Height="Auto" />
                 <RowDefinition Height="Auto" />
                 <RowDefinition Height="Auto" />
             </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource IconText}"
                           Foreground="{StaticResource AccentBrush}"
                           Text="&#xE7F6;" />
                <TextBlock Margin="8,0,0,0"
                           FontWeight="SemiBold"
                           Text="输出设备" />
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,7,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <ComboBox Height="32"
                          ItemsSource="{Binding Network.PlaybackDevices}"
                          SelectedIndex="{Binding Network.SelectedPlaybackDeviceIndex, Mode=TwoWay}"
                          Tag="{Binding Network.SelectedPlaybackDeviceDisplayName}"
                          DisplayMemberPath="DisplayName" />
                <Button Grid.Column="1"
                        Width="30"
                        Height="30"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="刷新播放设备"
                        Command="{Binding Network.RefreshOutputsCommand}"
                        Style="{StaticResource IconButton}"
                        ToolTip="刷新播放设备">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" />
                </Button>
            </Grid>
            <CheckBox Grid.Row="2"
                      Margin="0,7,0,0"
                      Style="{StaticResource FluentSwitchCheckBox}"
                      IsChecked="{Binding Network.FollowSystemDefaultPlayback, Mode=TwoWay}"
                      Content="跟随 Windows 系统默认输出" />
            <Grid Grid.Row="3" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="42" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="10"
                           Text="主输出" />
                <Slider Grid.Column="1" Margin="9,0,6,0"
                        Minimum="0" Maximum="100"
                        ToolTip="当前 Windows 输出设备音量"
                        Value="{Binding Network.MasterVolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                           FontSize="10" Text="{Binding Network.MasterVolumePercent, StringFormat={}{0:F0}%}" />
                <ToggleButton Grid.Column="3" Width="32" Height="30" HorizontalAlignment="Right"
                              Style="{StaticResource MuteToggleButton}"
                              IsChecked="{Binding Network.IsSystemMuted, Mode=TwoWay}"
                              ToolTip="{Binding Network.SystemMuteButtonText}">
                    <TextBlock HorizontalAlignment="Center" FontSize="13" Style="{StaticResource IconText}" Text="&#xE74F;" />
                </ToggleButton>
            </Grid>
            <ItemsControl Grid.Row="4" Margin="0,8,0,0" ItemsSource="{Binding Network.AdditionalOutputs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,6" Padding="9,7"
                                AllowDrop="True"
                                Background="#151D27"
                                BorderBrush="{StaticResource StrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                DragEnter="AdditionalOutput_DragOver"
                                DragOver="AdditionalOutput_DragOver"
                                Drop="AdditionalOutput_Drop">
                            <StackPanel>
                                 <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconText}" Foreground="{StaticResource AccentBrush}" FontSize="13" Text="&#xE7F6;" />
                                        <TextBlock Margin="6,0,0,0" FontSize="11" FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" Text="{Binding Summary}" />
                                 </Grid>
                                 <Grid Margin="0,6,0,0">
                                     <Grid.ColumnDefinitions>
                                         <ColumnDefinition Width="*" />
                                         <ColumnDefinition Width="36" />
                                         <ColumnDefinition Width="34" />
                                     </Grid.ColumnDefinitions>
                                     <Slider Minimum="0" Maximum="100"
                                             ToolTip="此 Windows 输出设备音量"
                                             Value="{Binding VolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                     <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                FontSize="9" Text="{Binding VolumePercent, StringFormat={}{0:F0}%}" />
                                     <ToggleButton Grid.Column="2" Width="28" Height="26" HorizontalAlignment="Right"
                                                   Style="{StaticResource MuteToggleButton}"
                                                   IsChecked="{Binding IsMuted, Mode=TwoWay}"
                                                   ToolTip="{Binding MuteButtonText}">
                                         <TextBlock HorizontalAlignment="Center" FontSize="11" Style="{StaticResource IconText}" Text="&#xE74F;" />
                                     </ToggleButton>
                                 </Grid>
                                 <ItemsControl Margin="0,5,0,0" ItemsSource="{Binding Routes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" FontSize="10" Text="{Binding SourceName}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Margin="7,0" VerticalAlignment="Center" Foreground="{StaticResource SuccessBrush}" FontSize="9" Text="{Binding StatusText}" />
                                                <Button Grid.Column="2" Width="25" Height="23"
                                                        AutomationProperties.Name="{Binding SourceName, StringFormat=从附加输出移除 {0}}"
                                                        Click="AdditionalOutputRoute_RemoveClick"
                                                        Style="{StaticResource IconButton}"
                                                        ToolTip="取消此附加输出">
                                                    <TextBlock Style="{StaticResource IconText}" FontSize="10" Text="&#xE711;" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</Border>
</UserControl>
