<UserControl x:Class="ListenSphere.Controller.Views.LocalApplicationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ListenSphere.Controller">
    <StackPanel>
<Grid Margin="2,18,0,10">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal">
        <TextBlock Style="{StaticResource IconText}"
                   Foreground="{StaticResource WarningBrush}"
                   Text="&#xE7F5;" />
        <TextBlock Margin="9,0,0,0"
                   Style="{StaticResource SectionHeading}"
                   Text="本机应用" />
    </StackPanel>
</Grid>
<Border Margin="0,0,0,8"
        Padding="18"
        Background="{StaticResource SurfaceSubtleBrush}"
        BorderBrush="Transparent"
        BorderThickness="0"
        CornerRadius="10"
        Visibility="{Binding Sessions.Count,
            Converter={StaticResource ZeroCountToVisibilityConverter}}">
    <StackPanel>
        <TextBlock FontWeight="SemiBold" Text="当前没有应用正在播放声音" />
        <TextBlock Margin="0,4,0,0"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Text="播放游戏、音乐或视频后，对应应用会自动显示在这里。" />
    </StackPanel>
</Border>
<ItemsControl ItemsSource="{Binding Sessions}">
    <ItemsControl.ItemTemplate>
        <DataTemplate>
            <Border MinHeight="70"
                    Margin="0,0,0,6"
                    Padding="12,9"
                    Background="{StaticResource SurfaceSubtleBrush}"
                    BorderBrush="Transparent"
                    BorderThickness="1"
                    CornerRadius="10"
                    PreviewMouseLeftButtonDown="LocalApplicationSource_PreviewMouseLeftButtonDown"
                    MouseMove="LocalApplicationSource_MouseMove">
                <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="1.7*" />
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="64" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" Background="#222A35" CornerRadius="9">
                        <Grid>
                            <Image Margin="4" Source="{Binding Icon}" Stretch="Uniform" />
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="&#xE7F5;">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource IconText}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold"
                                   Text="{Binding DisplayName}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   Text="{Binding ProcessText}" />
                        <TextBlock Margin="0,2,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="10"
                                   Text="{Binding WindowsOutputText}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding WindowsOutputText}" />
                    </StackPanel>
                    <ProgressBar Grid.Column="2"
                                 Margin="12,0"
                                 VerticalAlignment="Center"
                                 Maximum="100"
                                 local:AudioLevelBehavior.Level="{Binding PeakPercent, Mode=OneWay}" />
                    <Slider Grid.Column="3"
                            Margin="12,0"
                            Minimum="0"
                            Maximum="100"
                            Value="{Binding VolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="4"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontFamily="Consolas"
                               Text="{Binding VolumePercent, StringFormat={}{0:F0}%}" />
                    <ToggleButton Grid.Column="5"
                            Width="72"
                            Height="34"
                            Style="{StaticResource MuteToggleButton}"
                            IsChecked="{Binding IsEditorOpen, Mode=TwoWay}"
                            AutomationProperties.Name="展开应用路由"
                            ToolTip="查看 Windows 原始路由与聆界附加输出">
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Margin="0,0,5,0" Style="{StaticResource IconText}" Text="&#xE8F1;" />
                            <TextBlock VerticalAlignment="Center" FontSize="11" Text="路由" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Grid.Column="6"
                                  Width="54"
                                  Height="34"
                                  Style="{StaticResource MuteToggleButton}"
                                  AutomationProperties.Name="{Binding MuteButtonText}"
                                  ToolTip="{Binding MuteButtonText}"
                                  IsChecked="{Binding IsMuted, Mode=TwoWay}">
                        <TextBlock HorizontalAlignment="Center"
                                   Style="{StaticResource IconText}"
                                   Text="&#xE74F;" />
                    </ToggleButton>
                </Grid>
                <Border Margin="44,9,0,0"
                        Padding="12,10"
                        Background="#111821"
                        BorderBrush="{StaticResource StrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditorOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="11" FontWeight="SemiBold" Text="Windows 原始路由" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="10"
                                       Text="{Binding WindowsOutputText}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding WindowsOutputText}" />
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="10"
                                       Text="输入设备：由 Windows 按应用设置管理" />
                            <Button Margin="0,9,0,0"
                                    MinWidth="214"
                                    Height="30"
                                    Padding="12,0"
                                    HorizontalAlignment="Left"
                                    Click="OpenWindowsAppVolumeSettings_Click"
                                    AutomationProperties.Name="打开 Windows 应用输入输出设置">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,6,0" Style="{StaticResource IconText}" Text="&#xE713;" />
                                    <TextBlock Text="更改 Windows 输入/输出" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Border Grid.Column="1" Width="1" Background="{StaticResource StrokeBrush}" />
                        <StackPanel Grid.Column="2">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Text="聆界附加输出" />
                            <TextBlock Margin="0,4,0,5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="10"
                                       Text="{Binding AdditionalOutputSummary}" />
                            <Grid Margin="0,2,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="82" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Margin="0,0,7,0"
                                          Height="30"
                                          ItemsSource="{Binding AvailableAdditionalOutputs}"
                                          SelectedItem="{Binding SelectedAdditionalOutput, Mode=TwoWay}"
                                          DisplayMemberPath="DeviceName"
                                          ToolTip="选择要增加的附加输出设备" />
                                <Button Grid.Column="1"
                                        Height="30"
                                        Click="AddApplicationOutput_Click"
                                        AutomationProperties.Name="添加附加输出设备">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="IsEnabled" Value="True" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedAdditionalOutput}" Value="{x:Null}">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                        <TextBlock Margin="0,0,5,0" Style="{StaticResource IconText}" Text="&#xE710;" />
                                        <TextBlock Text="添加" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding AdditionalOutputRoutes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="30" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="10"
                                                       Text="{Binding DeviceName}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="8,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource SuccessBrush}"
                                                       FontSize="9"
                                                       Text="{Binding StatusText}" />
                                            <Button Grid.Column="2"
                                                    Width="26"
                                                    Height="24"
                                                    Command="{Binding RemoveCommand}"
                                                    Style="{StaticResource IconButton}"
                                                    ToolTip="移除此附加输出">
                                                <TextBlock Style="{StaticResource IconText}" FontSize="10" Text="&#xE711;" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="9"
                                       Text="也可以将应用卡片拖到下方输出设备。" />
                        </StackPanel>
                    </Grid>
                </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </ItemsControl.ItemTemplate>
</ItemsControl>
    </StackPanel>
</UserControl>
