<UserControl x:Class="ListenSphere.Controller.Views.FirstRunGuideDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#CC101827">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFirstRunGuideVisible}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border Width="570"
                Padding="34"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource SurfaceRaisedBrush}"
                BorderBrush="{StaticResource StrokeBrush}"
                BorderThickness="1"
                CornerRadius="18">
            <StackPanel>
                <TextBlock FontSize="25"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Text="欢迎使用聆界" />
                <TextBlock Margin="0,8,0,22"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="只需确认声音来源和最终输出，不需要理解专业音频参数。" />
                <TextBlock Margin="0,7" FontSize="15" Text="1  选择你的耳机或音箱" />
                <TextBlock Margin="0,7" FontSize="15" Text="2  播放声音，确认本机应用声道出现" />
                <TextBlock Margin="0,7" FontSize="15" Text="3  点击“启用发送连接”添加另一台设备" />
                <TextBlock Margin="0,7" FontSize="15" Text="4  调整音量并保存常用场景" />
                <TextBlock Margin="0,18,0,0"
                           Foreground="{StaticResource WarningBrush}"
                           Text="提示：双机网络验证可稍后补做；当前可先体验本机声道和场景。"
                           TextWrapping="Wrap" />
                <Button Margin="0,24,0,0"
                        HorizontalAlignment="Right"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding FinishGuideCommand}"
                        Content="进入聆界" />
            </StackPanel>
        </Border>
    </Border>
</UserControl>
