<UserControl x:Class="ListenSphere.Controller.Views.MicrophoneHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ListenSphere.Controller.Views">
    <Border Margin="0,12,0,0"
            Padding="14,12"
            Background="{StaticResource SurfaceSubtleBrush}"
            BorderBrush="{StaticResource StrokeBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}"
                               Foreground="{StaticResource AccentBrush}"
                               Text="&#xE720;" />
                    <TextBlock Margin="8,0,0,0"
                               FontWeight="SemiBold"
                               Text="麦克风中枢" />
                </StackPanel>
                <TextBlock Margin="0,4,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="10"
                           Text="输入来源 → 聆界 → Windows 录音设备" />
                <CheckBox Margin="0,8,0,0"
                          Style="{StaticResource FluentSwitchCheckBox}"
                          IsChecked="{Binding Network.MicrophoneOutputEnabled, Mode=TwoWay}"
                          Content="启用麦克风中枢"
                          ToolTip="默认关闭；开启后才会捕获和转发麦克风声音" />
            </StackPanel>
            <views:MicrophoneRoutingView Grid.Column="1" />
            <views:MicrophoneMonitoringView Grid.Column="2" />
            <ToggleButton Grid.Column="3"
                          Width="36"
                          Height="34"
                          VerticalAlignment="Center"
                          Style="{StaticResource MuteToggleButton}"
                          IsEnabled="{Binding Network.MicrophoneOutputEnabled}"
                          IsChecked="{Binding Network.MicrophoneOutputMuted, Mode=TwoWay}"
                          ToolTip="静音全部远程麦克风输出">
                <TextBlock Style="{StaticResource IconText}"
                           FontSize="15"
                           Text="&#xE74F;" />
            </ToggleButton>
        </Grid>
    </Border>
</UserControl>
