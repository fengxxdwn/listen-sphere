<UserControl x:Class="ListenSphere.Controller.Views.ControllerDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:ListenSphere.Controller.Views"
             xmlns:design="clr-namespace:ListenSphere.Controller.Design"
             d:DataContext="{d:DesignInstance Type=design:ControllerDashboardDesignData, IsDesignTimeCreatable=True}"
             d:DesignWidth="1022"
             d:DesignHeight="778"
             mc:Ignorable="d">
    <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <views:ContentHeaderView />

            <ScrollViewer Grid.Row="1"
                          Padding="22"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Margin="0,0,0,12"
                            Padding="14,9"
                            Background="#121820"
                            CornerRadius="9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.7*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource AccentBrush}"
                                           Text="&#xE703;" />
                                <TextBlock Margin="9,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{Binding Network.Transport.NetworkStatus}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Column="1" Margin="12,0" Background="#28313D" />
                            <StackPanel Grid.Column="2"
                                        Margin="15,0"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                <Ellipse Width="7" Height="7"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         Fill="{StaticResource SuccessBrush}" />
                                <TextBlock VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="{Binding Network.RemoteDevices.ActiveRemoteChannels.Count, StringFormat={}远程 {0} 个声道}" />
                            </StackPanel>
                            <Border Grid.Column="3" Margin="12,0" Background="#28313D" />
                            <StackPanel Grid.Column="4"
                                        Margin="15,0"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource WarningBrush}"
                                           Text="&#xE7F5;" />
                                <TextBlock VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="{Binding LocalSessions.Sessions.Count, StringFormat={}本机 {0} 个会话}" />
                            </StackPanel>
                        </Grid>

                    </Border>
                    <views:AudioSourceRoutingView />

                    <views:MicrophoneHubView />
                    <Grid Margin="2,22,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}"
                                       Foreground="{StaticResource AccentBrush}"
                                       Text="&#xE772;" />
                            <TextBlock Margin="9,0,0,0"
                                       Style="{StaticResource SectionHeading}"
                                       Text="其他设备" />
                        </StackPanel>
                    </Grid>
                    <Border Margin="0,0,0,8"
                            Padding="18"
                            Background="{StaticResource SurfaceSubtleBrush}"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="10"
                            Visibility="{Binding Network.RemoteDevices.VisibleRemoteChannels.Count,
                                Converter={StaticResource ZeroCountToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="当前连接方式没有设备" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{Binding Network.Transport.EmptyTransportText}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource PrimaryButton}"
                                    AutomationProperties.Name="添加远程设备"
                                    Command="{Binding EnableSenderCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE710;" />
                                    <TextBlock Margin="7,0,0,0" Text="添加设备" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton Margin="0,0,6,0"
                                     GroupName="RemoteTransport"
                                     IsChecked="{Binding Network.Transport.IsWirelessSelected, Mode=OneWay}"
                                     Command="{Binding Network.Transport.SelectWirelessCommand}"
                                     Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="Card" Padding="12,10" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="9">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Card" Property="Background" Value="#1B2948" />
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="#5576A8" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Foreground="{StaticResource AccentBrush}" Text="&#xE701;" />
                                <StackPanel Margin="9,0,0,0">
                                    <TextBlock FontWeight="SemiBold" Text="无线网络" />
                                    <TextBlock Foreground="{StaticResource SuccessBrush}" FontSize="10" Text="当前可用" />
                                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                        <TextBlock MaxWidth="275"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="9"
                                                   Text="{Binding Network.Transport.WirelessIpAddressText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Network.Transport.WirelessIpAddressText}" />
                                        <TextBlock Margin="12,0,0,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="9"
                                                   Text="{Binding Network.Transport.WirelessPortText}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="1" Margin="3,0"
                                     GroupName="RemoteTransport"
                                     IsChecked="{Binding Network.Transport.IsBluetoothSelected, Mode=OneWay}"
                                     Command="{Binding Network.Transport.SelectBluetoothCommand}"
                                     Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="Card" Padding="12,10" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="9">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Card" Property="Background" Value="#1B2948" />
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="#5576A8" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Foreground="{StaticResource AccentBrush}" Text="&#xE702;" />
                                <StackPanel Margin="9,0,0,0">
                                    <TextBlock FontWeight="SemiBold" Text="蓝牙" />
                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="10"
                                               Text="{Binding Network.Transport.BluetoothStatus}" />
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="2" Margin="6,0,0,0"
                                     GroupName="RemoteTransport"
                                     IsChecked="{Binding Network.Transport.IsWiredSelected, Mode=OneWay}"
                                     Command="{Binding Network.Transport.SelectWiredCommand}"
                                     Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="Card" Padding="12,10" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="9">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Card" Property="Background" Value="#1B2948" />
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="#5576A8" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Foreground="{StaticResource TextSecondaryBrush}" Text="&#xE88E;" />
                                <StackPanel Margin="9,0,0,0">
                                    <TextBlock FontWeight="SemiBold" Text="有线" />
                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Text="{Binding Network.Transport.UsbStatus}" />
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Network.RemoteDevices.VisibleRemoteChannels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border MinHeight="70"
                                        Margin="0,0,0,6"
                                        Padding="12,9"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        CornerRadius="9">
                                    <Border.RenderTransform>
                                        <TranslateTransform Y="0" />
                                    </Border.RenderTransform>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1B2431" />
                                                    <Setter Property="BorderBrush" Value="#3A4D68" />
                                                </Trigger>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.24" />
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="8" To="0" Duration="0:0:0.28">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" Background="#1B2948" CornerRadius="9">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource IconText}"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       Text="&#xE7F7;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard x:Name="OnlinePulse">
                                                                            <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.55" To="1" Duration="0:0:0.9" />
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                    <DataTrigger.ExitActions>
                                                                        <RemoveStoryboard BeginStoryboardName="OnlinePulse" />
                                                                    </DataTrigger.ExitActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="11"
                                                           Text="{Binding ListTransportLabel}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Margin="12,0"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   Text="{Binding StatusText}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="3"
                                                Margin="4,0,0,0"
                                                AutomationProperties.Name="删除设备"
                                                Command="{Binding DeleteCommand}"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="删除设备并撤销信任（再次连接需要重新配对）">
                                            <TextBlock Style="{StaticResource IconText}"
                                                       Foreground="{StaticResource ErrorBrush}"
                                                       Text="&#xE74D;" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <views:LocalApplicationsView />

                    <Border Margin="0,14,0,0" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource IconText}"
                                       Foreground="{StaticResource SuccessBrush}"
                                       Text="&#xE9D9;" />
                            <StackPanel Grid.Column="1">
                                <TextBlock FontWeight="SemiBold" Text="稳定性与诊断" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           Text="{Binding Diagnostics.StatusText}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Margin="14,0,0,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="导出诊断包"
                                    Command="{Binding Diagnostics.ExportCommand}"
                                    Content="导出诊断" />
                        </Grid>
                    </Border>

                    <TextBlock Margin="2,14,0,0"
                               Foreground="{StaticResource ErrorBrush}"
                               Text="{Binding LocalSessions.ErrorText}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
</UserControl>
