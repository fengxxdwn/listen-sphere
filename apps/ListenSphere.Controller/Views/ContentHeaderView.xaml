<UserControl x:Class="ListenSphere.Controller.Views.ContentHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Border Padding="22,13"
        Background="{StaticResource SidebarBrush}"
        BorderThickness="0">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
            <TextBlock FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Text="声音中枢" />
            <TextBlock Margin="0,3,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="{Binding LocalSessions.StatusText}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Height="34"
                    Margin="0,0,10,0"
                    Padding="12,5"
                    Style="{StaticResource PrimaryButton}"
                    AutomationProperties.Name="启用发送连接"
                    Command="{Binding EnableSenderCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE703;" />
                    <TextBlock Margin="8,0,0,0" Text="启用发送连接" />
                </StackPanel>
            </Button>
            <Border Margin="0,0,10,0"
                    Padding="10,6"
                    VerticalAlignment="Center"
                    Background="#172131"
                    CornerRadius="14">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6"
                             Margin="0,0,7,0"
                             VerticalAlignment="Center"
                             Fill="{StaticResource SuccessBrush}" />
                    <TextBlock VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="{Binding Network.Transport.NetworkStatus}" />
                </StackPanel>
            </Border>
            <Button AutomationProperties.Name="刷新应用"
                    Command="{Binding LocalSessions.RefreshCommand}"
                    Style="{StaticResource IconButton}"
                    ToolTip="刷新应用列表">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" />
            </Button>
        </StackPanel>
    </Grid>
</Border>
</UserControl>
