<UserControl x:Class="ListenSphere.Controller.Views.ChannelTuningHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Text="{Binding TransportLabel}" />
                    <TextBlock Margin="7,0,0,0" Foreground="{StaticResource SuccessBrush}" FontSize="11" Text="{Binding StatusText}" />
                </StackPanel>
            </StackPanel>
            <ToggleButton Grid.Column="1" MinWidth="86" Height="32" Padding="10,0"
                          Style="{StaticResource MuteToggleButton}"
                          IsChecked="{Binding IsEqualizerEnabled, Mode=TwoWay}"
                          Content="均衡器启用" />
        </Grid>
        <Border Margin="0,14,0,12" Padding="12,10" Background="#151D27" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="用途分组" />
                <ComboBox Grid.Column="1" Height="34" Margin="12,0,0,0"
                          ItemsSource="{Binding AvailableChannelGroups}"
                          SelectedItem="{Binding SelectedChannelGroup, Mode=TwoWay}" />
                <TextBlock Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"
                           Text="修改后会自动记住；同名来源下次连接时直接进入此分组。" />
                <TextBlock Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="调音预设" />
                <ComboBox Grid.Row="1" Grid.Column="1" Height="34" Margin="12,10,0,0"
                          ItemsSource="{Binding EqualizerPresets}"
                          SelectedItem="{Binding SelectedEqualizerPreset, Mode=TwoWay}"
                          DisplayMemberPath="Name" />
                <TextBlock Grid.Row="1" Grid.Column="2" Margin="14,10,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"
                           Text="预设会立即作用于该来源；手动调整后自动标记为自定义。" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
