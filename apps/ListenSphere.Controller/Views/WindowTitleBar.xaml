<UserControl x:Class="ListenSphere.Controller.Views.WindowTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Border Grid.Row="0"
        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
    <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#0B0F15" />
            <GradientStop Offset="0.58" Color="#0E141C" />
            <GradientStop Offset="1" Color="#10161F" />
        </LinearGradientBrush>
    </Border.Background>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
            <Border Width="22" Height="22" Background="#1B2948" CornerRadius="6">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Segoe Fluent Icons"
                           FontSize="12"
                           Foreground="{StaticResource AccentBrush}"
                           Text="&#xE7F8;" />
            </Border>
            <TextBlock Margin="9,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#DCE3ED"
                       Text="聆界" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Style="{StaticResource WindowCaptionButton}"
                    AutomationProperties.Name="最小化"
                    Click="MinimizeButton_Click"
                    ToolTip="最小化">
                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="10" Text="&#xE921;" />
            </Button>
            <Button Style="{StaticResource WindowCaptionButton}"
                    AutomationProperties.Name="最大化或还原"
                    Click="MaximizeRestoreButton_Click"
                    ToolTip="最大化/还原">
                <TextBlock x:Name="MaximizeRestoreGlyph" FontFamily="Segoe Fluent Icons" FontSize="10" Text="&#xE922;" />
            </Button>
            <Button Style="{StaticResource WindowCloseButton}"
                    AutomationProperties.Name="关闭"
                    Click="CloseButton_Click"
                    ToolTip="关闭">
                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="10" Text="&#xE8BB;" />
            </Button>
        </StackPanel>
    </Grid>
</Border>
</UserControl>
