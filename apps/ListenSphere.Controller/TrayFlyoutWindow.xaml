<Window x:Class="ListenSphere.Controller.TrayFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ListenSphere.Controller.Views"
        Title="聆界设备管理"
        Width="420"
        MaxHeight="650"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI"
        Foreground="{StaticResource TextPrimaryBrush}"
        Deactivated="OnDeactivated">
    <Border Margin="10"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource StrokeBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              Direction="270"
                              Opacity="0.42"
                              ShadowDepth="7"
                              Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="18,16,18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               Text="全部音源" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="音量、静音、断连与十段均衡器" />
                </StackPanel>
                <Border Grid.Column="1"
                        MinWidth="30"
                        Height="25"
                        Padding="8,0"
                        VerticalAlignment="Center"
                        Background="#1F4C78F0"
                        CornerRadius="12">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource AccentBrush}"
                               Text="{Binding Network.RemoteDevices.ActiveRemoteChannels.Count, StringFormat={}远程 {0}}" />
                </Border>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          MaxHeight="480"
                          Padding="12,0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Margin="0,0,0,12"
                            Padding="12"
                            Background="{StaticResource SurfaceRaisedBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="本机声音" />
                                    <TextBlock Margin="0,2,0,0"
                                               FontSize="10"
                                               Foreground="{StaticResource AccentBrush}"
                                               Text="Windows 系统主输出" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Width="34"
                                              Height="32"
                                              AutomationProperties.Name="本机声音静音"
                                              IsChecked="{Binding Network.LocalRouting.IsLocalSourceMuted, Mode=TwoWay}"
                                              Style="{StaticResource MuteToggleButton}"
                                              ToolTip="{Binding Network.LocalRouting.LocalSourceMuteButtonText}">
                                    <TextBlock HorizontalAlignment="Center"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="14"
                                               Text="&#xE74F;" />
                                </ToggleButton>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="42" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="&#xE767;" />
                                <Slider Grid.Column="1"
                                        Margin="9,0"
                                        Minimum="0"
                                        Maximum="100"
                                        ToolTip="本机声音音量"
                                        Value="{Binding Network.LocalRouting.LocalSourceVolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="2"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           Text="{Binding Network.LocalRouting.LocalSourceVolumePercent, StringFormat={}{0:F0}%}" />
                            </Grid>
                            <Expander Margin="0,8,0,0">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontWeight="SemiBold" Text="均衡器" />
                                        <TextBlock Margin="8,0,0,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="{Binding Network.LocalRouting.Equalizer.SelectedEqualizerPreset.Name}" />
                                    </StackPanel>
                                </Expander.Header>
                                <ContentControl Content="{Binding Network.LocalRouting.Equalizer}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <views:TrayEqualizerView />
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="4,0,0,8"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="活动的远程与应用音源" />
                    <TextBlock Margin="18,8,18,18"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="暂无其他活动音源"
                               Visibility="{Binding Network.RemoteDevices.ActiveRemoteChannels.Count,
                                   Converter={StaticResource ZeroCountToVisibilityConverter}}" />

                    <ItemsControl ItemsSource="{Binding Network.RemoteDevices.ActiveRemoteChannels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="12"
                                        Background="{StaticResource SurfaceRaisedBrush}"
                                        BorderBrush="{StaticResource StrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,2,0,0"
                                                       FontSize="10"
                                                       Foreground="{StaticResource SuccessBrush}"
                                                       Text="{Binding SourceSubtitle}" />
                                        </StackPanel>

                                        <ToggleButton Grid.Column="1"
                                                      Width="34"
                                                      Height="32"
                                                      Margin="8,0,0,0"
                                                      AutomationProperties.Name="{Binding MuteButtonText}"
                                                      IsChecked="{Binding IsMuted, Mode=TwoWay}"
                                                      Style="{StaticResource MuteToggleButton}"
                                                      ToolTip="{Binding MuteButtonText}">
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="14"
                                                       Text="&#xE74F;" />
                                        </ToggleButton>
                                        <Button Grid.Column="2"
                                                Width="34"
                                                Height="32"
                                                Margin="6,0,0,0"
                                                AutomationProperties.Name="断开连接"
                                                Command="{Binding DisconnectCommand}"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="断开连接（保留设备信任）">
                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="14"
                                                       Foreground="{StaticResource WarningBrush}"
                                                       Text="&#xE8BB;" />
                                        </Button>

                                        <Grid Grid.Row="1"
                                              Grid.ColumnSpan="3"
                                              Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="42" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="&#xE767;" />
                                            <Slider Grid.Column="1"
                                                    Margin="9,0"
                                                    Minimum="0"
                                                    Maximum="100"
                                                    ToolTip="设备音量"
                                                    Value="{Binding VolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Column="2"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Consolas"
                                                       FontSize="10"
                                                       Text="{Binding VolumePercent, StringFormat={}{0:F0}%}" />
                                        </Grid>
                                        <Expander Grid.Row="2"
                                                  Grid.ColumnSpan="3"
                                                  Margin="0,8,0,0">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontWeight="SemiBold" Text="均衡器" />
                                                    <TextBlock Margin="8,0,0,0"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Text="{Binding SelectedEqualizerPreset.Name}" />
                                                </StackPanel>
                                            </Expander.Header>
                                            <views:TrayEqualizerView />
                                        </Expander>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Padding="12"
                    BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="0,1,0,0">
                <Button Height="38"
                        HorizontalContentAlignment="Center"
                        Click="OnExitClick"
                        Content="退出聆界"
                        ToolTip="停止音频服务并退出应用" />
            </Border>
        </Grid>
    </Border>
</Window>
