                                                                                </StackPanel>
                                                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                                    <CheckBox Margin="0,0,12,0" IsChecked="{Binding IsVoiceDuckingTrigger, Mode=TwoWay}" Content="语音触发" />
