                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE710;" />
                                    <TextBlock Margin="7,0,0,0" Text="添加设备" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton Margin="0,0,6,0"
                                     GroupName="RemoteTransport"
                                     IsChecked="{Binding Network.IsWirelessSelected, Mode=OneWay}"
                                     Command="{Binding Network.SelectWirelessCommand}"
                                     Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="Card" Padding="12,10" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="9">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Card" Property="Background" Value="#1B2948" />
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="#5576A8" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Foreground="{StaticResource AccentBrush}" Text="&#xE701;" />
                                <StackPanel Margin="9,0,0,0">
                                    <TextBlock FontWeight="SemiBold" Text="无线网络" />
                                    <TextBlock Foreground="{StaticResource SuccessBrush}" FontSize="10" Text="当前可用" />
                                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                        <TextBlock MaxWidth="275"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="9"
                                                   Text="{Binding Network.WirelessIpAddressText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Network.WirelessIpAddressText}" />
                                        <TextBlock Margin="12,0,0,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="9"
                                                   Text="{Binding Network.WirelessPortText}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="1" Margin="3,0"
                                     GroupName="RemoteTransport"
                                     IsChecked="{Binding Network.IsBluetoothSelected, Mode=OneWay}"
                                     Command="{Binding Network.SelectBluetoothCommand}"
                                     Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="Card" Padding="12,10" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="9">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Card" Property="Background" Value="#1B2948" />
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="#5576A8" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Foreground="{StaticResource AccentBrush}" Text="&#xE702;" />
                                <StackPanel Margin="9,0,0,0">
                                    <TextBlock FontWeight="SemiBold" Text="蓝牙" />
                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="10"
                                               Text="{Binding Network.BluetoothStatus}" />
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="2" Margin="6,0,0,0"
                                     GroupName="RemoteTransport"
                                     IsChecked="{Binding Network.IsWiredSelected, Mode=OneWay}"
                                     Command="{Binding Network.SelectWiredCommand}"
                                     Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="Card" Padding="12,10" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="9">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Card" Property="Background" Value="#1B2948" />
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="#5576A8" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Foreground="{StaticResource TextSecondaryBrush}" Text="&#xE88E;" />
                                <StackPanel Margin="9,0,0,0">
                                    <TextBlock FontWeight="SemiBold" Text="有线" />
                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Text="{Binding Network.UsbStatus}" />
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Network.VisibleRemoteChannels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border MinHeight="70"
                                        Margin="0,0,0,6"
                                        Padding="12,9"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        CornerRadius="9">
                                    <Border.RenderTransform>
                                        <TranslateTransform Y="0" />
                                    </Border.RenderTransform>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1B2431" />
                                                    <Setter Property="BorderBrush" Value="#3A4D68" />
                                                </Trigger>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.24" />
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="8" To="0" Duration="0:0:0.28">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" Background="#1B2948" CornerRadius="9">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource IconText}"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       Text="&#xE7F7;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard x:Name="OnlinePulse">
                                                                            <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.55" To="1" Duration="0:0:0.9" />
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                    <DataTrigger.ExitActions>
                                                                        <RemoveStoryboard BeginStoryboardName="OnlinePulse" />
                                                                    </DataTrigger.ExitActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="11"
                                                           Text="{Binding ListTransportLabel}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Margin="12,0"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   Text="{Binding StatusText}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="3"
                                                Margin="4,0,0,0"
                                                AutomationProperties.Name="删除设备"
                                                Command="{Binding DeleteCommand}"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="删除设备并撤销信任（再次连接需要重新配对）">
                                            <TextBlock Style="{StaticResource IconText}"
                                                       Foreground="{StaticResource ErrorBrush}"
                                                       Text="&#xE74D;" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="2,18,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}"
                                       Foreground="{StaticResource WarningBrush}"
                                       Text="&#xE7F5;" />
                            <TextBlock Margin="9,0,0,0"
                                       Style="{StaticResource SectionHeading}"
                                       Text="本机应用" />
                        </StackPanel>
                    </Grid>
                    <Border Margin="0,0,0,8"
                            Padding="18"
                            Background="{StaticResource SurfaceSubtleBrush}"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Sessions.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="当前没有应用正在播放声音" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="播放游戏、音乐或视频后，对应应用会自动显示在这里。" />
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Sessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border MinHeight="70"
                                        Margin="0,0,0,6"
                                        Padding="12,9"
                                        Background="{StaticResource SurfaceSubtleBrush}"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="1.7*" />
                                            <ColumnDefinition Width="54" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="64" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" Background="#222A35" CornerRadius="9">
                                            <Grid>
                                                <Image Margin="4" Source="{Binding Icon}" Stretch="Uniform" />
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Text="&#xE7F5;">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource IconText}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       Text="{Binding ProcessText}" />
                                        </StackPanel>
                                        <ProgressBar Grid.Column="2"
                                                     Margin="12,0"
                                                     VerticalAlignment="Center"
                                                     Maximum="100"
                                                     local:AudioLevelBehavior.Level="{Binding PeakPercent, Mode=OneWay}" />
                                        <Slider Grid.Column="3"
                                                Margin="12,0"
                                                Minimum="0"
                                                Maximum="100"
                                                Value="{Binding VolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="4"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Consolas"
                                                   Text="{Binding VolumePercent, StringFormat={}{0:F0}%}" />
                                        <TextBlock Grid.Column="5"
                                                   Margin="12,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding ActivityBrush}"
                                                   FontSize="11"
                                                   Text="{Binding ActivityText}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <ToggleButton Grid.Column="6"
                                                      Width="54"
                                                      Height="34"
                                                      Style="{StaticResource MuteToggleButton}"
                                                      AutomationProperties.Name="{Binding MuteButtonText}"
                                                      ToolTip="{Binding MuteButtonText}"
                                                      IsChecked="{Binding IsMuted, Mode=TwoWay}">
                                            <TextBlock HorizontalAlignment="Center"
                                                       Style="{StaticResource IconText}"
                                                       Text="&#xE74F;" />
                                        </ToggleButton>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Margin="0,14,0,0" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource IconText}"
                                       Foreground="{StaticResource SuccessBrush}"
                                       Text="&#xE9D9;" />
                            <StackPanel Grid.Column="1">
                                <TextBlock FontWeight="SemiBold" Text="稳定性与诊断" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           Text="{Binding DiagnosticStatusText}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Margin="14,0,0,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="导出诊断包"
                                    Command="{Binding ExportDiagnosticsCommand}"
                                    Content="导出诊断" />
                        </Grid>
                    </Border>

                    <TextBlock Margin="2,14,0,0"
                               Foreground="{StaticResource ErrorBrush}"
                               Text="{Binding ErrorText}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.ColumnSpan="2"
                Panel.ZIndex="20"
                Background="#CC101827">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFirstRunGuideVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border Width="570"
                    Padding="34"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="18">
                <StackPanel>
                    <TextBlock FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="欢迎使用聆界" />
                    <TextBlock Margin="0,8,0,22"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="只需确认声音来源和最终输出，不需要理解专业音频参数。" />
                    <TextBlock Margin="0,7" FontSize="15" Text="1  选择你的耳机或音箱" />
                    <TextBlock Margin="0,7" FontSize="15" Text="2  播放声音，确认本机应用声道出现" />
                    <TextBlock Margin="0,7" FontSize="15" Text="3  点击“启用发送连接”添加另一台设备" />
                    <TextBlock Margin="0,7" FontSize="15" Text="4  调整音量并保存常用场景" />
                    <TextBlock Margin="0,18,0,0"
                               Foreground="{StaticResource WarningBrush}"
                               Text="提示：双机网络验证可稍后补做；当前可先体验本机声道和场景。"
                               TextWrapping="Wrap" />
                    <Button Margin="0,24,0,0"
                            HorizontalAlignment="Right"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding FinishGuideCommand}"
                            Content="进入聆界" />
                </StackPanel>
            </Border>
        </Border>

        <Border Grid.ColumnSpan="2"
                Panel.ZIndex="30"
                Background="#D90B0F15">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Network.IsDeleteConfirmationVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border Width="470"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="#704048"
                    BorderThickness="1"
                    CornerRadius="16">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0"
                                                 To="1"
                                                 Duration="0:0:0.16" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="0.97"
                                                 To="1"
                                                 Duration="0:0:0.18" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.97"
                                                 To="1"
                                                 Duration="0:0:0.18" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42"
                                Height="42"
                                Background="#3A2229"
                                CornerRadius="11">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource IconText}"
                                       FontSize="20"
                                       Foreground="{StaticResource ErrorBrush}"
                                       Text="&#xE74D;" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="20"
                                       FontWeight="SemiBold"
                                       Text="删除这台设备？" />
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="此操作会撤销设备信任" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Row="1"
                               Margin="0,22,0,22"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               LineHeight="23"
                               TextWrapping="Wrap">
                        <Run Text="设备“" />
                        <Run FontWeight="SemiBold"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             Text="{Binding Network.DeleteConfirmationDeviceName, Mode=OneWay}" />
                        <Run Text="”将立即断开并从可信设备中移除。再次连接时，需要重新输入六位验证码。" />
                    </TextBlock>
                    <StackPanel Grid.Row="2"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button MinWidth="86"
                                AutomationProperties.Name="取消删除设备"
                                Command="{Binding Network.CancelDeleteCommand}"
                                Content="取消" />
                        <Button MinWidth="106"
                                Margin="10,0,0,0"
                                Background="#B94E59"
                                BorderBrush="{StaticResource ErrorBrush}"
                                AutomationProperties.Name="确认删除设备"
                                Command="{Binding Network.ConfirmDeleteCommand}"
                                Content="删除设备"
                                FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
        </Grid>
    </Grid>
</Window>
