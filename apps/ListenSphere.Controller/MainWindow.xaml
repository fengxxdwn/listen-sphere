                                                                    <Border Margin="0,0,0,12" Padding="12,10" Background="#151D27" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8">
                                                                        <StackPanel>
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="Auto" />
