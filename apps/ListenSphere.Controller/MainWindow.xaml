<Window x:Class="ListenSphere.Controller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="聆界 · ListenSphere Controller"
        Width="1180"
        Height="780"
        MinWidth="940"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        Background="#F5F7FA">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E4E9EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Background" Value="#EDF2F7" />
            <Setter Property="BorderBrush" Value="#D5DDE6" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#3768D9" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#3768D9" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#172238">
            <Grid Margin="22,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Foreground="White"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Text="聆界" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="#9EADC5"
                               Text="ListenSphere Controller" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,32,0,0">
                    <TextBlock Foreground="#9EADC5" FontSize="12" Text="场景" />
                    <ListBox Height="142"
                             Margin="0,8,0,0"
                             Background="#202E48"
                             BorderThickness="0"
                             Foreground="White"
                             ItemsSource="{Binding Scenes}"
                             SelectedItem="{Binding SelectedScene}"
                             DisplayMemberPath="Name" />
                    <TextBox Height="32"
                             Margin="0,10,0,0"
                             Padding="8,5"
                             Text="{Binding NewSceneName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="输入场景名称；留空将自动命名" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Command="{Binding SaveSceneCommand}" Content="保存当前" />
                        <Button Margin="6,0,0,0"
                                Command="{Binding ApplySceneCommand}"
                                Content="恢复" />
                        <Button Margin="6,0,0,0"
                                Command="{Binding DeleteSceneCommand}"
                                Content="删除" />
                    </WrapPanel>
                    <TextBlock Margin="0,8,0,0"
                               Foreground="#B9C5D8"
                               FontSize="11"
                               Text="{Binding SceneStatusText}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <TextBlock Foreground="#9EADC5" FontSize="12" Text="添加设备" />
                    <Border Margin="0,8,0,0"
                            Padding="12"
                            Background="#202E48"
                            CornerRadius="10">
                        <StackPanel>
                            <TextBlock Foreground="White" Text="一次性配对码" />
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="#7FD6B2"
                                       FontFamily="Consolas"
                                       FontSize="25"
                                       FontWeight="SemiBold"
                                       Text="{Binding Network.PairingCode}" />
                            <Button Margin="0,8,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding Network.GenerateCodeCommand}"
                                    Content="生成验证码" />
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="#B9C5D8"
                                       FontSize="11"
                                       Text="{Binding Network.PairingHint}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Padding="26,20"
                    Background="White"
                    BorderBrush="#E4E9EF"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#182235"
                                   Text="声音总览" />
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="#647184"
                                   Text="{Binding StatusText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   Foreground="#647184"
                                   Text="{Binding Network.NetworkStatus}" />
                        <Button Command="{Binding RefreshCommand}" Content="刷新应用" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          Padding="26"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="250" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="250" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#182235"
                                           Text="播放输出" />
                                <TextBlock Margin="0,5,0,0"
                                           Foreground="#647184"
                                           Text="{Binding Network.AudioStatus}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,5,0,0"
                                           Foreground="#B53D4C"
                                           Text="{Binding Network.AudioErrorText}"
                                           TextWrapping="Wrap" />
                                <CheckBox Margin="0,9,0,0"
                                          IsChecked="{Binding Network.FollowSystemDefaultPlayback, Mode=TwoWay}"
                                          Content="跟随 Windows 系统默认输出" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      Height="34"
                                      VerticalAlignment="Center"
                                      ItemsSource="{Binding Network.PlaybackDevices}"
                                      SelectedItem="{Binding Network.SelectedPlaybackDevice}"
                                      DisplayMemberPath="DisplayName" />
                            <Button Grid.Column="2"
                                    Margin="8,0,28,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding Network.RefreshOutputsCommand}"
                                    Content="刷新设备" />
                            <Grid Grid.Column="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="#647184" Text="主音量" />
                                    <TextBlock Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               Text="{Binding Network.MasterVolumePercent, StringFormat={}{0:F0}%}" />
                                </Grid>
                                <Slider Grid.Row="1"
                                        Margin="0,7,0,0"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="{Binding Network.MasterVolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Grid>
                    </Border>
                    <TextBlock Margin="2,24,0,10"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#182235"
                               Text="远程设备声道" />
                    <ItemsControl ItemsSource="{Binding Network.RemoteChannels}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="292"
                                        MinHeight="176"
                                        Margin="0,0,12,12"
                                        Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" Background="#EAF0FF" CornerRadius="9">
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="#3768D9"
                                                           FontSize="17"
                                                           Text="PC" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontWeight="SemiBold"
                                                           Text="{Binding DisplayName}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,3,0,0"
                                                           Foreground="#647184"
                                                           FontSize="12"
                                                           Text="{Binding StatusText}" />
                                            </StackPanel>
                                            <Ellipse Grid.Column="2" Width="9" Height="9">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#AAB4C1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                <Setter Property="Fill" Value="#36A875" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,17,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="48" />
                                            </Grid.ColumnDefinitions>
                                            <Slider Minimum="0"
                                                    Maximum="100"
                                                    Value="{Binding VolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Column="1"
                                                       HorizontalAlignment="Right"
                                                       Text="{Binding VolumePercent, StringFormat={}{0:F0}%}" />
                                        </Grid>
                                        <ProgressBar Grid.Row="2"
                                                     Height="7"
                                                     Margin="0,13,0,0"
                                                     Maximum="100"
                                                     Value="{Binding PeakPercent, Mode=OneWay}" />
                                        <ToggleButton Grid.Row="3"
                                                      Height="31"
                                                      Margin="0,13,0,0"
                                                      IsChecked="{Binding IsMuted, Mode=TwoWay}"
                                                      Content="{Binding MuteButtonText}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Margin="2,12,0,10"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#182235"
                               Text="本机应用声道" />
                    <ItemsControl ItemsSource="{Binding Sessions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="292"
                                        MinHeight="190"
                                        Margin="0,0,12,12"
                                        Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" Background="#EFF2F6" CornerRadius="9">
                                                <Grid>
                                                    <Image Source="{Binding Icon}" Stretch="Uniform" />
                                                    <TextBlock HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="#647184"
                                                               Text="♪">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontWeight="SemiBold"
                                                           Text="{Binding DisplayName}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,3,0,0"
                                                           Foreground="#647184"
                                                           FontSize="12"
                                                           Text="{Binding ProcessText}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Foreground="{Binding ActivityBrush}"
                                                       FontSize="12"
                                                       Text="{Binding ActivityText}" />
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,17,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="48" />
                                            </Grid.ColumnDefinitions>
                                            <Slider Minimum="0"
                                                    Maximum="100"
                                                    Value="{Binding VolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Column="1"
                                                       HorizontalAlignment="Right"
                                                       Text="{Binding VolumePercent, StringFormat={}{0:F0}%}" />
                                        </Grid>
                                        <ProgressBar Grid.Row="2"
                                                     Height="7"
                                                     Margin="0,13,0,0"
                                                     Maximum="100"
                                                     Value="{Binding PeakPercent, Mode=OneWay}" />
                                        <ToggleButton Grid.Row="3"
                                                      Height="31"
                                                      Margin="0,13,0,0"
                                                      IsChecked="{Binding IsMuted, Mode=TwoWay}"
                                                      Content="{Binding MuteButtonText}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Margin="0,12,0,0" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="270" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="可信设备管理" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="#647184"
                                           Text="撤销后，该设备必须重新输入验证码才能连接。" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      Height="32"
                                      VerticalAlignment="Center"
                                      ItemsSource="{Binding Network.TrustedDevices}"
                                      SelectedItem="{Binding Network.SelectedTrustedDevice}"
                                      DisplayMemberPath="DisplayName" />
                            <Button Grid.Column="2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding Network.RevokeCommand}"
                                    Content="撤销信任" />
                        </Grid>
                    </Border>

                    <Border Margin="0,12,0,0" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="稳定性与诊断" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="#647184"
                                           Text="{Binding DiagnosticStatusText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Margin="14,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ExportDiagnosticsCommand}"
                                    Content="导出诊断包" />
                        </Grid>
                    </Border>

                    <TextBlock Margin="2,14,0,0"
                               Foreground="#B53D4C"
                               Text="{Binding ErrorText}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.ColumnSpan="2"
                Panel.ZIndex="20"
                Background="#CC101827">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFirstRunGuideVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border Width="570"
                    Padding="34"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="White"
                    CornerRadius="18">
                <StackPanel>
                    <TextBlock FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="#182235"
                               Text="欢迎使用聆界" />
                    <TextBlock Margin="0,8,0,22"
                               Foreground="#647184"
                               Text="四步完成首次设置，无需填写 IP 或音频参数。" />
                    <TextBlock Margin="0,7" FontSize="15" Text="1  在顶部选择你的耳机或音箱" />
                    <TextBlock Margin="0,7" FontSize="15" Text="2  播放一段声音，确认本机应用声道出现" />
                    <TextBlock Margin="0,7" FontSize="15" Text="3  在左下角生成验证码，并在发送端输入" />
                    <TextBlock Margin="0,7" FontSize="15" Text="4  听到远程声音后，保存一个常用场景" />
                    <TextBlock Margin="0,18,0,0"
                               Foreground="#8A5B22"
                               Text="提示：双机网络验证可稍后补做；当前可先体验本机声道和场景。"
                               TextWrapping="Wrap" />
                    <Button Margin="0,24,0,0"
                            HorizontalAlignment="Right"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding FinishGuideCommand}"
                            Content="进入聆界" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
