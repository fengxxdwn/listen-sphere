                                   Text="{Binding SenderStatusText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,15,0,12" VerticalAlignment="Top">
                    <TextBlock Style="{StaticResource EyebrowText}" Text="场景预设" />
                    <ListBox Height="142"
                              Margin="0,8,0,0"
                              ItemsSource="{Binding Scenes}"
                             SelectedItem="{Binding SelectedScene}"
                             DisplayMemberPath="Name" />
                    <TextBox Height="32"
                             Margin="0,10,0,0"
                             Padding="8,5"
                             Text="{Binding NewSceneName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="输入场景名称；留空将自动命名" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Command="{Binding SaveSceneCommand}" Content="保存当前" />
                        <Button Margin="6,0,0,0"
                                Command="{Binding ApplySceneCommand}"
                                Content="恢复" />
                        <Button Margin="6,0,0,0"
                                Command="{Binding DeleteSceneCommand}"
                                Content="删除" />
                    </WrapPanel>
                    <WrapPanel Margin="0,6,0,0">
                        <Button Command="{Binding RenameSceneCommand}" Content="重命名" />
                        <Button Margin="6,0,0,0" Command="{Binding DuplicateSceneCommand}" Content="复制" />
                        <Button Margin="6,0,0,0" Command="{Binding ImportSceneCommand}" Content="导入" />
                        <Button Margin="6,0,0,0" Command="{Binding ExportSceneCommand}" Content="导出" />
                    </WrapPanel>
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               Text="{Binding SceneStatusText}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <TextBlock Style="{StaticResource EyebrowText}" Text="添加设备" />
                    <Border Margin="0,8,0,0"
                            Padding="12"
                            Background="{StaticResource SurfaceSubtleBrush}"
                            CornerRadius="10">
                        <StackPanel>
                            <TextBlock Foreground="White" Text="一次性配对码" />
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="#7FD6B2"
                                       FontFamily="Consolas"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Text="{Binding Network.PairingCode}" />
                            <Button Margin="0,8,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding Network.GenerateCodeCommand}"
                                    Content="{Binding Network.PairingCodeActionText}" />
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       Text="{Binding Network.PairingHint}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Padding="22,13"
                    Background="{StaticResource SidebarBrush}"
                    BorderThickness="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="声音中枢" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding StatusText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Height="34"
                                Margin="0,0,10,0"
                                Padding="12,5"
                                Style="{StaticResource PrimaryButton}"
                                AutomationProperties.Name="启用发送连接"
                                Command="{Binding EnableSenderCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE703;" />
                                <TextBlock Margin="8,0,0,0" Text="启用发送连接" />
                            </StackPanel>
                        </Button>
                        <Border Margin="0,0,10,0"
                                Padding="10,6"
                                VerticalAlignment="Center"
                                Background="#172131"
                                CornerRadius="14">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6"
                                         Margin="0,0,7,0"
                                         VerticalAlignment="Center"
                                         Fill="{StaticResource SuccessBrush}" />
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{Binding Network.NetworkStatus}" />
                            </StackPanel>
                        </Border>
                        <Button AutomationProperties.Name="刷新应用"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource IconButton}"
                                ToolTip="刷新应用列表">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          Padding="22"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Margin="0,0,0,12"
                            Padding="14,9"
                            Background="#121820"
                            CornerRadius="9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.7*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource AccentBrush}"
                                           Text="&#xE703;" />
                                <TextBlock Margin="9,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{Binding Network.NetworkStatus}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Column="1" Margin="12,0" Background="#28313D" />
                            <StackPanel Grid.Column="2"
                                        Margin="15,0"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                <Ellipse Width="7" Height="7"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         Fill="{StaticResource SuccessBrush}" />
                                <TextBlock VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="{Binding Network.ActiveRemoteChannels.Count, StringFormat={}远程 {0} 个声道}" />
                            </StackPanel>
                            <Border Grid.Column="3" Margin="12,0" Background="#28313D" />
                            <StackPanel Grid.Column="4"
                                        Margin="15,0"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource WarningBrush}"
                                           Text="&#xE7F5;" />
                                <TextBlock VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="{Binding Sessions.Count, StringFormat={}本机 {0} 个会话}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Margin="0,0,0,16"
                             Padding="14"
                             Background="{StaticResource SurfaceSubtleBrush}"
                             BorderBrush="Transparent"
                             BorderThickness="1"
                             CornerRadius="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.25*" />
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="1.25*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <Grid Margin="0,0,0,7">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconText}"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   Text="&#xE7F7;" />
                                        <TextBlock Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Text="声音来源" />
                                    </StackPanel>
                                    <ToggleButton x:Name="GroupMixerButton"
                                                  Width="72" Height="28"
                                                  HorizontalAlignment="Right"
                                                  Padding="7,0"
                                                  Style="{StaticResource MuteToggleButton}"
                                                  IsChecked="{Binding Network.IsGroupMixerOpen, Mode=TwoWay}"
                                                  ToolTip="打开分组混音器">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource IconText}" FontSize="13" Foreground="{StaticResource AccentBrush}" Text="&#xE9D2;" />
                                            <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" FontSize="10" Text="分组" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <Popup IsOpen="{Binding Network.IsGroupMixerOpen, Mode=TwoWay}"
                                           PlacementTarget="{Binding ElementName=GroupMixerButton}"
                                           Placement="Bottom"
                                           HorizontalOffset="-425"
                                           StaysOpen="False"
                                           AllowsTransparency="True">
                                        <Border Width="500" Margin="0,7,0,0" Padding="15"
                                                Background="{StaticResource SurfaceRaisedBrush}"
                                                BorderBrush="{StaticResource AccentBrush}"
                                                BorderThickness="1" CornerRadius="11">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="分组混音器" />
                                                        <TextBlock Margin="0,3,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"
                                                                   Text="分组控制叠加在各声道设置之后，不会改写设备自己的音量和均衡器。" />
                                                    </StackPanel>
                                                    <ToggleButton Grid.Column="1" MinWidth="104" Height="31" Padding="9,0"
                                                                  Style="{StaticResource MuteToggleButton}"
                                                                  IsChecked="{Binding Network.AutomaticRoutingEnabled, Mode=TwoWay}"
                                                                  Content="自动路由" />
                                                </Grid>
                                                <TextBlock Margin="0,5,0,12" Foreground="{StaticResource AccentBrush}" FontSize="10"
                                                           Text="{Binding Network.AutomaticRoutingStatus}" />
                                                <ItemsControl ItemsSource="{Binding Network.ActiveGroupBuses}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,0,7" Padding="10,8" Background="#151D27"
                                                                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="85" />
                                                                        <ColumnDefinition Width="115" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="42" />
                                                                        <ColumnDefinition Width="38" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                                        <TextBlock FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding ChannelCountText}" />
                                                                    </StackPanel>
                                                                    <ComboBox Grid.Column="1" Height="31" Margin="7,0"
                                                                              ItemsSource="{Binding EqualizerPresets}"
                                                                              SelectedItem="{Binding SelectedEqualizerPreset, Mode=TwoWay}"
                                                                              DisplayMemberPath="Name" />
                                                                    <Slider Grid.Column="2" Margin="8,0" Minimum="0" Maximum="100"
                                                                            Value="{Binding VolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                    <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10"
                                                                               Text="{Binding VolumePercent, StringFormat={}{0:F0}%}" />
                                                                    <ToggleButton Grid.Column="4" Width="34" Height="31" Margin="4,0,0,0"
                                                                                  Style="{StaticResource MuteToggleButton}"
                                                                                  IsChecked="{Binding IsMuted, Mode=TwoWay}"
                                                                                  ToolTip="{Binding MuteButtonText}">
                                                                        <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE74F;" />
                                                                    </ToggleButton>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Text="当前没有已连接的远程声道。">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Network.ActiveGroupBuses.Count}" Value="0">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Border Height="1" Margin="0,10,0,10" Background="{StaticResource StrokeBrush}" />
                                                <Grid Margin="0,0,0,7">
                                                    <TextBlock FontWeight="SemiBold" Text="已学习路由规则" />
                                                    <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"
                                                               Text="关闭单条规则不会删除记录" />
                                                </Grid>
                                                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding Network.RoutingRules}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Margin="0,0,0,6" Padding="9,7" Background="#151D27"
                                                                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="76" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions>
                                                                        <StackPanel>
                                                                            <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Margin="0,2,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" Text="{Binding MatchSummary}" />
                                                                        </StackPanel>
                                                                        <ToggleButton Grid.Column="1" Height="29" Margin="7,0" Padding="7,0"
                                                                                      Style="{StaticResource MuteToggleButton}"
                                                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                                      Content="启用" />
                                                                        <Button Grid.Column="2" Width="32" Height="29" Command="{Binding DeleteCommand}"
                                                                                Style="{StaticResource IconButton}" ToolTip="删除此路由规则">
                                                                            <TextBlock Style="{StaticResource IconText}" Foreground="{StaticResource ErrorBrush}" Text="&#xE74D;" />
                                                                        </Button>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Text="尚未学习规则；在声道调音中修改用途分组即可创建。">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers><DataTrigger Binding="{Binding Network.RoutingRules.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Grid Margin="0,2"
                                              Background="Transparent"
                                              PreviewMouseLeftButtonDown="LocalSource_PreviewMouseLeftButtonDown"
                                              MouseMove="LocalSource_MouseMove"
                                              ToolTip="拖动卡片可将 Windows 本地总声音同时输出到其他播放设备">
                                            <Border Padding="10,8"
                                                    Background="#171F29"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    CornerRadius="9">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold" Text="本地声音" />
                                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Text="进入聆界的本机音源增益" />
                                                        </StackPanel>
                                                        <ToggleButton Grid.Column="1"
                                                                      Width="36" Height="32"
                                                                      VerticalAlignment="Center"
                                                                      Style="{StaticResource MuteToggleButton}"
                                                                      IsChecked="{Binding Network.IsLocalSourceMuted, Mode=TwoWay}"
                                                                      ToolTip="{Binding Network.LocalSourceMuteButtonText}">
                                                            <TextBlock HorizontalAlignment="Center" FontSize="15" Style="{StaticResource IconText}" Text="&#xE74F;" />
                                                        </ToggleButton>
                                                    </Grid>
                                                    <Grid Margin="0,7,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                                                        <Slider Minimum="0"
                                                                Maximum="100"
                                                                ToolTip="本机音源增益"
                                                                Value="{Binding Network.LocalSourceVolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        <TextBlock Grid.Column="1"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="11"
                                                                   Text="{Binding Network.LocalSourceVolumePercent, StringFormat={}{0:F0}%}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                            <Border IsHitTestVisible="False"
                                                    BorderBrush="#4C8DFF"
                                                    BorderThickness="1.25"
                                                    CacheMode="BitmapCache"
                                                    CornerRadius="7"
                                                    Opacity="0.035"
                                                    local:AudioGlowBehavior.Level="{Binding LocalPeakPercent}">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="14"
                                                                      Color="#3F83FF"
                                                                      Direction="0"
                                                                      Opacity="0.9"
                                                                      ShadowDepth="0" />
                                                </Border.Effect>
                                            </Border>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Network.ActiveRemoteChannels}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2"
                                                          Background="Transparent"
                                                          PreviewMouseLeftButtonDown="RemoteSource_PreviewMouseLeftButtonDown"
                                                          MouseMove="RemoteSource_MouseMove"
                                                          ToolTip="{Binding NetworkQualityToolTip}">
                                                        <Border Padding="10,8"
                                                                Background="#171F29"
                                                                BorderBrush="Transparent"
                                                                BorderThickness="1"
                                                                CornerRadius="9">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="120" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="40" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                                                                    <StackPanel>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Margin="0,0,6,0" Style="{StaticResource IconText}" Foreground="{StaticResource AccentBrush}" FontSize="13" Text="{Binding SourceGlyph}" />
                                                                            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                                        </StackPanel>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Text="{Binding SourceSubtitle}" />
                                                                            <TextBlock Margin="6,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Text="{Binding StatusText}" />
                                                                            <TextBlock Margin="6,0,0,0" Foreground="{StaticResource AccentBrush}" FontSize="10" Text="{Binding SelectedChannelGroup}" />
                                                                            <TextBlock Margin="6,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" Text="{Binding RoutingStatus}" />
                                                                            <TextBlock Margin="6,0,0,0" Foreground="{Binding NetworkQualityColor}" FontSize="9" Text="{Binding NetworkQualityText}" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                    <ToggleButton x:Name="RemoteSourceButton"
                                                                                  Grid.Column="1"
                                                                                  MinWidth="96" Height="32"
                                                                                  Margin="6,0"
                                                                                  Padding="9,0"
                                                                                  VerticalAlignment="Center"
                                                                                  IsChecked="{Binding IsEditorOpen, Mode=TwoWay}"
                                                                                  Style="{StaticResource MuteToggleButton}"
                                                                                  ToolTip="打开声道调音">
                                                                        <Grid MinWidth="76">
                                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                                                                <TextBlock Style="{StaticResource IconText}" Foreground="{StaticResource AccentBrush}" Text="&#xE9E9;" />
                                                                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="10" Text="{Binding SelectedEqualizerPreset.Name}" />
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </ToggleButton>
                                                                    <ToggleButton Grid.Column="2" Width="36" Height="32" VerticalAlignment="Center" Style="{StaticResource MuteToggleButton}" IsChecked="{Binding IsMuted, Mode=TwoWay}" ToolTip="{Binding MuteButtonText}">
                                                                        <TextBlock HorizontalAlignment="Center" FontSize="15" Style="{StaticResource IconText}" Text="&#xE74F;" />
                                                                    </ToggleButton>
                                                                    <Button Grid.Column="3" Width="32" Height="32" VerticalAlignment="Center" Command="{Binding DisconnectCommand}" Style="{StaticResource IconButton}" ToolTip="断开连接（保留设备信任）">
                                                                        <TextBlock Style="{StaticResource IconText}" Foreground="{StaticResource WarningBrush}" Text="&#xE8BB;" />
                                                                    </Button>
                                                                </Grid>
                                                                <Grid Margin="0,7,0,0">
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0" Margin="0,0,7,0" Orientation="Horizontal">
                                                                        <ToggleButton Width="25" Height="25" Style="{StaticResource MuteToggleButton}"
                                                                                      IsChecked="{Binding IsPinned, Mode=TwoWay}" ToolTip="固定到声道列表顶部">
                                                                            <TextBlock Style="{StaticResource IconText}" FontSize="11" Text="&#xE840;" />
                                                                        </ToggleButton>
                                                                        <Button Width="23" Height="25" Margin="3,0,0,0" Command="{Binding MoveUpCommand}"
                                                                                Style="{StaticResource IconButton}" ToolTip="上移声道">
                                                                            <TextBlock Style="{StaticResource IconText}" FontSize="10" Text="&#xE70E;" />
                                                                        </Button>
                                                                        <Button Width="23" Height="25" Margin="3,0,0,0" Command="{Binding MoveDownCommand}"
                                                                                Style="{StaticResource IconButton}" ToolTip="下移声道">
                                                                            <TextBlock Style="{StaticResource IconText}" FontSize="10" Text="&#xE70D;" />
                                                                        </Button>
                                                                    </StackPanel>
                                                                    <Slider Grid.Column="1" Minimum="0" Maximum="100" ToolTip="设备音量" Value="{Binding VolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Text="{Binding VolumePercent, StringFormat={}{0:F0}%}" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border IsHitTestVisible="False"
                                                                BorderBrush="#4C8DFF"
                                                                BorderThickness="1.25"
                                                                CacheMode="BitmapCache"
                                                                CornerRadius="7"
                                                                Opacity="0.035"
                                                                local:AudioGlowBehavior.Level="{Binding AudioGlowLevel}">
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="14"
                                                                                  Color="#3F83FF"
                                                                                  Direction="0"
                                                                                  Opacity="0.9"
                                                                                  ShadowDepth="0" />
                                                            </Border.Effect>
                                                        </Border>
                                                        <Popup IsOpen="{Binding IsEditorOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=RemoteSourceButton}" Placement="Right" StaysOpen="False" AllowsTransparency="True">
                                                            <Border Width="740" Margin="8,0,0,0" Padding="16" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="10">
                                                                <StackPanel>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                        <StackPanel>
                                                                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                                            <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                                                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Text="{Binding TransportLabel}" />
                                                                                <TextBlock Margin="7,0,0,0" Foreground="{StaticResource SuccessBrush}" FontSize="11" Text="{Binding StatusText}" />
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                        <ToggleButton Grid.Column="1" MinWidth="86" Height="32" Padding="10,0"
                                                                                      Style="{StaticResource MuteToggleButton}"
                                                                                      IsChecked="{Binding IsEqualizerEnabled, Mode=TwoWay}"
                                                                                      Content="均衡器启用" />
                                                                    </Grid>
                                                                    <Border Margin="0,14,0,12" Padding="12,10" Background="#151D27" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8">
                                                                        <Grid>
                                                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="用途分组" />
                                                                            <ComboBox Grid.Column="1" Height="34" Margin="12,0,0,0"
