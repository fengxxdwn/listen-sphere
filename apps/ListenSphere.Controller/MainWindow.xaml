                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="10"
                                           Text="手机麦克风 → 虚拟录音设备" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <ComboBox Height="32"
                                          ItemsSource="{Binding Network.MicrophoneOutputDevices}"
                                          SelectedItem="{Binding Network.SelectedMicrophoneOutputDevice}"
                                          DisplayMemberPath="DisplayName" />
                                <TextBlock Margin="2,5,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="9"
                                           Text="{Binding Network.MicrophoneOutputStatus}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Network.MicrophoneOutputStatus}" />
