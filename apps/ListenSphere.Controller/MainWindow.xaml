                                        <StackPanel>
                                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="汇聚与播放详情" />
                                            <TextBlock Margin="0,9,0,0" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Network.AudioStatus}" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,7,0,0" Foreground="{StaticResource ErrorBrush}" Text="{Binding Network.AudioErrorText}" TextWrapping="Wrap" />
                                            <Separator Margin="0,10,0,8" Background="{StaticResource StrokeBrush}" />
                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Text="数据包含接收端口、混音路数、缺帧与丢包状态；点击卡片外部关闭。" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>

                            <TextBlock Grid.Column="3"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource IconText}"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="&#xE76C;" />

                            <Grid Grid.Column="4" VerticalAlignment="Center">
                                 <Grid.RowDefinitions>
                                     <RowDefinition Height="Auto" />
                                     <RowDefinition Height="Auto" />
                                     <RowDefinition Height="Auto" />
                                     <RowDefinition Height="Auto" />
                                     <RowDefinition Height="Auto" />
                                 </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}"
                                               Foreground="{StaticResource AccentBrush}"
                                               Text="&#xE7F6;" />
                                    <TextBlock Margin="8,0,0,0"
                                               FontWeight="SemiBold"
                                               Text="输出设备" />
                                </StackPanel>
                                <Grid Grid.Row="1" Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Height="32"
                                              ItemsSource="{Binding Network.PlaybackDevices}"
                                              SelectedItem="{Binding Network.SelectedPlaybackDevice}"
                                              DisplayMemberPath="DisplayName" />
                                    <Button Grid.Column="1"
                                            Width="30"
                                            Height="30"
                                            HorizontalAlignment="Right"
                                            AutomationProperties.Name="刷新播放设备"
                                            Command="{Binding Network.RefreshOutputsCommand}"
                                            Style="{StaticResource IconButton}"
                                            ToolTip="刷新播放设备">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" />
                                    </Button>
                                </Grid>
                                <CheckBox Grid.Row="2"
                                          Margin="0,7,0,0"
                                          Style="{StaticResource FluentSwitchCheckBox}"
                                          IsChecked="{Binding Network.FollowSystemDefaultPlayback, Mode=TwoWay}"
                                          Content="跟随 Windows 系统默认输出" />
                                <Grid Grid.Row="3" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="42" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="10"
                                               Text="主输出" />
                                    <Slider Grid.Column="1" Margin="9,0,6,0"
                                            Minimum="0" Maximum="100"
                                            ToolTip="当前 Windows 输出设备音量"
                                            Value="{Binding Network.MasterVolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                               FontSize="10" Text="{Binding Network.MasterVolumePercent, StringFormat={}{0:F0}%}" />
                                    <ToggleButton Grid.Column="3" Width="32" Height="30" HorizontalAlignment="Right"
                                                  Style="{StaticResource MuteToggleButton}"
                                                  IsChecked="{Binding Network.IsSystemMuted, Mode=TwoWay}"
                                                  ToolTip="{Binding Network.SystemMuteButtonText}">
                                        <TextBlock HorizontalAlignment="Center" FontSize="13" Style="{StaticResource IconText}" Text="&#xE74F;" />
                                    </ToggleButton>
                                </Grid>
                                <ItemsControl Grid.Row="4" Margin="0,8,0,0" ItemsSource="{Binding Network.AdditionalOutputs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6" Padding="9,7"
                                                    AllowDrop="True"
                                                    Background="#151D27"
                                                    BorderBrush="{StaticResource StrokeBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="7"
                                                    DragEnter="AdditionalOutput_DragOver"
                                                    DragOver="AdditionalOutput_DragOver"
                                                    Drop="AdditionalOutput_Drop">
                                                <StackPanel>
                                                     <Grid>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Style="{StaticResource IconText}" Foreground="{StaticResource AccentBrush}" FontSize="13" Text="&#xE7F6;" />
                                                            <TextBlock Margin="6,0,0,0" FontSize="11" FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" Text="{Binding Summary}" />
                                                     </Grid>
                                                     <Grid Margin="0,6,0,0">
                                                         <Grid.ColumnDefinitions>
                                                             <ColumnDefinition Width="*" />
                                                             <ColumnDefinition Width="36" />
                                                             <ColumnDefinition Width="34" />
                                                         </Grid.ColumnDefinitions>
                                                         <Slider Minimum="0" Maximum="100"
                                                                 ToolTip="此 Windows 输出设备音量"
                                                                 Value="{Binding VolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                         <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                                    FontSize="9" Text="{Binding VolumePercent, StringFormat={}{0:F0}%}" />
                                                         <ToggleButton Grid.Column="2" Width="28" Height="26" HorizontalAlignment="Right"
                                                                       Style="{StaticResource MuteToggleButton}"
                                                                       IsChecked="{Binding IsMuted, Mode=TwoWay}"
                                                                       ToolTip="{Binding MuteButtonText}">
                                                             <TextBlock HorizontalAlignment="Center" FontSize="11" Style="{StaticResource IconText}" Text="&#xE74F;" />
                                                         </ToggleButton>
                                                     </Grid>
                                                     <ItemsControl Margin="0,5,0,0" ItemsSource="{Binding Routes}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,2,0,0">
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
                                                                    <TextBlock VerticalAlignment="Center" FontSize="10" Text="{Binding SourceName}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="1" Margin="7,0" VerticalAlignment="Center" Foreground="{StaticResource SuccessBrush}" FontSize="9" Text="{Binding StatusText}" />
                                                                    <Button Grid.Column="2" Width="25" Height="23" Command="{Binding RemoveCommand}" Style="{StaticResource IconButton}" ToolTip="取消此附加输出">
                                                                        <TextBlock Style="{StaticResource IconText}" FontSize="10" Text="&#xE711;" />
                                                                    </Button>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Margin="0,12,0,0"
                            Padding="14,12"
                            Background="{StaticResource SurfaceSubtleBrush}"
                            BorderBrush="{StaticResource StrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
