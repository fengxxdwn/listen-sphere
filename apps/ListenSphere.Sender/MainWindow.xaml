<Window x:Class="ListenSphere.Sender.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="聆界 · ListenSphere Sender"
        Width="820"
        Height="820"
        MinWidth="620"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        BorderThickness="0"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI"
        Foreground="#E7ECF3"
        Background="#0F131A">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#171D26" />
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#1C232E" />
        <SolidColorBrush x:Key="StrokeBrush" Color="#29313D" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E7ECF3" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8E99AA" />
        <SolidColorBrush x:Key="AccentBrush" Color="#4C78F0" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#45C392" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#E06C75" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="WindowCaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="42" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#AAB4C3" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionBackground" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionBackground" Property="Background" Value="#252C36" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionBackground" Property="Background" Value="#303946" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowCaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionBackground" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionBackground" Property="Background" Value="#C42B3A" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionBackground" Property="Background" Value="#A92330" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.70" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SourceModeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="#151C25" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        <Setter Property="Padding" Value="10,7" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder"
                                            Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#263654" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#304B83" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          Background="{TemplateBinding Background}"
                                          Foreground="{TemplateBinding Foreground}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Grid>
                                    <ContentPresenter Margin="10,0,34,0"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                                    <Path Width="9"
                                          Height="5"
                                          Margin="0,0,12,0"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Fill="{StaticResource TextSecondaryBrush}"
                                          Data="M 0 0 L 4.5 5 L 9 0 Z" />
                                </Grid>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="300"
                                        Margin="0,4,0,0"
                                        Background="{StaticResource SurfaceRaisedBrush}"
                                        BorderBrush="{StaticResource StrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Background" Value="#252D39" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="11" />
            <Setter Property="MinWidth" Value="11" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#3A4658" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                   Margin="2,3"
                                   Focusable="False"
                                   IsDirectionReversed="True"
                                   Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="Transparent" BorderThickness="0"
                                                  Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="34" Background="{TemplateBinding Foreground}">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbSurface"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbSurface" Property="Background" Value="#56657A" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbSurface" Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="Transparent" BorderThickness="0"
                                                  Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto" />
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="Height" Value="11" />
                                <Setter Property="MinHeight" Value="11" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                                <Setter TargetName="PART_Track" Property="Margin" Value="3,2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="#0F131A">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#0B0F15" />
                    <GradientStop Offset="0.58" Color="#0D1118" />
                    <GradientStop Offset="1" Color="#0F131A" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Width="22" Height="22" Background="#1B2948" CornerRadius="6">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="12"
                                   Foreground="{StaticResource AccentBrush}"
                                   Text="&#xE724;" />
                    </Border>
                    <TextBlock Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#DCE3ED"
                               Text="聆界" />
                    <TextBlock Margin="7,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="ListenSphere Sender" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource WindowCaptionButton}" AutomationProperties.Name="最小化" Click="MinimizeButton_Click" ToolTip="最小化">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="10" Text="&#xE921;" />
                    </Button>
                    <Button Style="{StaticResource WindowCaptionButton}" AutomationProperties.Name="最大化或还原" Click="MaximizeRestoreButton_Click" ToolTip="最大化/还原">
                        <TextBlock x:Name="MaximizeRestoreGlyph" FontFamily="Segoe Fluent Icons" FontSize="10" Text="&#xE922;" />
                    </Button>
                    <Button Style="{StaticResource WindowCloseButton}" AutomationProperties.Name="关闭" Click="CloseButton_Click" ToolTip="关闭">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="10" Text="&#xE8BB;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <Border Margin="24"
                Padding="28"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource StrokeBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" Background="#1B2948" CornerRadius="11">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Style="{StaticResource IconText}"
                                   FontSize="21"
                                   Foreground="{StaticResource AccentBrush}"
                                   Text="&#xE724;" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock FontSize="25" FontWeight="SemiBold" Text="聆界发送端" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13"
                                   Text="将这台电脑的声音发送到聆界主控端" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" />
                        <TextBlock Margin="7,0,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   Text="发送服务就绪" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Margin="0,24,0,0" Padding="16"
                        Background="#121820" BorderBrush="{StaticResource StrokeBrush}"
                        BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="13" FontWeight="SemiBold" Text="声音来源" />
                                <TextBlock Margin="0,3,0,0" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="选择要转发的应用；也可以切换为整个系统声音" />
                            </StackPanel>
                            <Button Grid.Column="1" Width="42" Height="38" MinHeight="0" Padding="0"
                                    Command="{Binding RefreshCommand}"
                                    AutomationProperties.Name="刷新声音来源" ToolTip="刷新声音来源">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" />
                            </Button>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Margin="0,0,5,0" Command="{Binding SelectApplicationsCommand}"
                                    Style="{StaticResource SourceModeButton}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ModeBorder" Padding="14,9"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1" CornerRadius="8">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="应用声音" />
                                                <TextBlock Margin="0,2,0,0" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Text="按应用选择，可多选" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsApplicationMode}" Value="True">
                                                <Setter TargetName="ModeBorder" Property="Background" Value="#20345F" />
                                                <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ModeBorder" Property="Opacity" Value="0.88" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Grid.Column="1" Margin="5,0,0,0" Command="{Binding SelectSystemCommand}"
                                    Style="{StaticResource SourceModeButton}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ModeBorder" Padding="14,9"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1" CornerRadius="8">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="整个系统" />
                                                <TextBlock Margin="0,2,0,0" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Text="转发所选输出设备的全部声音" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSystemMode}" Value="True">
                                                <Setter TargetName="ModeBorder" Property="Background" Value="#20345F" />
                                                <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ModeBorder" Property="Opacity" Value="0.88" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <Border Margin="0,12,0,0" Padding="10" Background="#151C25"
                                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsApplicationMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Grid Margin="4,0,4,8">
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="可发送的应用" />
                                    <TextBlock HorizontalAlignment="Right" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="{Binding SelectedApplicationCount, Mode=OneWay, StringFormat=已选择 {0} 个}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Applications}">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6" Padding="11,9" Background="#19212B"
                                                    BorderBrush="#2A3442" BorderThickness="1" CornerRadius="7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="130" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Margin="0,0,11,0" VerticalAlignment="Center"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              ToolTip="发送过程中也可以随时加入或移除此应用" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="0,2,0,0" FontSize="10"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   Text="{Binding ProcessText}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <ProgressBar Height="5" Maximum="100"
                                                                     Value="{Binding PeakPercent, Mode=OneWay}" />
                                                        <TextBlock Margin="0,4,0,0" HorizontalAlignment="Right" FontSize="10"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   Text="{Binding StatusText}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="4,8,4,2" FontSize="10"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="未播放声音的应用可能暂时不会出现在列表中。" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0" Padding="12" Background="#151C25"
                                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSystemMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="系统声音来自" />
                                <ComboBox Height="38" Margin="0,8,0,0" VerticalContentAlignment="Center"
                                          ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                          DisplayMemberPath="DisplayLabel" />
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="0,13,0,12" HorizontalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11" Text="传输至" />
                            <TextBlock Margin="0,1,0,0" HorizontalAlignment="Center"
                                       Foreground="{StaticResource AccentBrush}" FontSize="20" Text="↓" />
                        </StackPanel>

                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="目标设备" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Height="38" VerticalContentAlignment="Center"
                                      ItemsSource="{Binding Network.Controllers}"
                                      SelectedItem="{Binding Network.SelectedController}"
                                      DisplayMemberPath="DisplayLabel" />
                            <Button Grid.Column="1" Height="38" Margin="8,0,0,0"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding Network.ConnectCommand}" Content="连接" />
                        </Grid>
                        <TextBlock Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding Network.StatusText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2"
                            Margin="0,18,0,0"
                            Orientation="Horizontal">
                    <Button MinWidth="116"
                            Height="40"
                            Padding="16,0"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ToggleCaptureCommand}"
                            Content="{Binding ToggleCaptureText}" />
                    <Button MinWidth="116"
                            Height="40"
                            Margin="10,0,0,0"
                            Padding="16,0"
                            Command="{Binding TestToneCommand}"
                            Content="播放测试音" />
                    <Button MinWidth="142"
                            Height="40"
                            Margin="10,0,0,0"
                            Padding="16,0"
                            Command="{Binding RecordDebugWaveCommand}"
                            Content="录制 10 秒 WAV" />
                </StackPanel>

                <Grid Grid.Row="3" Margin="0,26,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text="瞬时" />
                    <ProgressBar Grid.Column="1"
                                 Height="12"
                                 VerticalAlignment="Center"
                                 Maximum="100"
                                 Value="{Binding PeakPercent, Mode=OneWay}" />
                    <TextBlock Grid.Column="2"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{Binding PeakPercent, StringFormat={}{0:F1}%}" />
                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text="平均" />
                    <ProgressBar Grid.Row="1"
                                 Grid.Column="1"
                                 Height="12"
                                 VerticalAlignment="Center"
                                 Maximum="100"
                                 Value="{Binding RmsPercent, Mode=OneWay}" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="2"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{Binding RmsPercent, StringFormat={}{0:F1}%}" />
                </Grid>

                <Border Grid.Row="4"
                        Margin="0,24,0,0"
                        Padding="16"
                        VerticalAlignment="Top"
                        Background="#121820"
                        BorderBrush="{StaticResource StrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{Binding StatusText}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding StatisticsText}" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{StaticResource ErrorBrush}"
                                   Text="{Binding ErrorText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        </ScrollViewer>
        </Grid>
        <Border Grid.RowSpan="2"
                Panel.ZIndex="20"
                Background="#D90B0F15">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Network.IsPairingPromptVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border Width="420"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="#3B4656"
                    BorderThickness="1"
                    CornerRadius="16">
                <StackPanel>
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="首次配对" />
                    <TextBlock Margin="0,8,0,18"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="请输入主控端显示的六位验证码。验证成功后，此设备将被记为可信设备。"
                               TextWrapping="Wrap" />
                    <TextBox Height="44"
                             MaxLength="6"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             FontSize="22"
                             Text="{Binding Network.PairingCode, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="{Binding Network.StatusText}"
                               TextWrapping="Wrap" />
                    <StackPanel Margin="0,22,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button MinWidth="88"
                                Command="{Binding Network.CancelPairingCommand}"
                                Content="取消" />
                        <Button MinWidth="98"
                                Margin="10,0,0,0"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding Network.SubmitPairingCommand}"
                                Content="确认配对" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
