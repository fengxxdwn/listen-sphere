<Window x:Class="ListenSphere.Sender.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="聆界 · ListenSphere Sender"
        Width="720"
        Height="690"
        MinWidth="620"
        MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F4F6F8">
        <Border Margin="36"
                Padding="32"
                Background="White"
                BorderBrush="#DCE2E8"
                BorderThickness="1"
                CornerRadius="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock FontSize="30" FontWeight="SemiBold" Text="聆界" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="#59636E"
                               FontSize="16"
                               Text="ListenSphere Sender · P4 加密 UDP 音频发送" />
                </StackPanel>

                <Border Grid.Row="1"
                        Margin="0,24,0,0"
                        Padding="14"
                        Background="#F7F9FB"
                        CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="96" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Height="34"
                                  ItemsSource="{Binding Network.Controllers}"
                                  SelectedItem="{Binding Network.SelectedController}"
                                  DisplayMemberPath="DisplayLabel" />
                        <TextBox Grid.Column="1"
                                 Height="34"
                                 Margin="8,0,0,0"
                                 MaxLength="6"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding Network.PairingCode, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="首次配对时输入六位验证码" />
                        <Button Grid.Column="2"
                                Height="34"
                                Margin="8,0,0,0"
                                Command="{Binding Network.ConnectCommand}"
                                Content="连接/配对" />
                        <TextBlock Grid.Row="1"
                                   Grid.ColumnSpan="3"
                                   Margin="0,8,0,0"
                                   Foreground="#53606D"
                                   Text="{Binding Network.StatusText}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Height="38"
                              VerticalContentAlignment="Center"
                              ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice}"
                              DisplayMemberPath="DisplayLabel" />
                    <Button Grid.Column="1"
                            Width="88"
                            Margin="10,0,0,0"
                            Command="{Binding RefreshCommand}"
                            Content="刷新设备" />
                </Grid>

                <StackPanel Grid.Row="3"
                            Margin="0,18,0,0"
                            Orientation="Horizontal">
                    <Button MinWidth="116"
                            Height="40"
                            Padding="16,0"
                            Command="{Binding ToggleCaptureCommand}"
                            Content="{Binding ToggleCaptureText}" />
                    <Button MinWidth="116"
                            Height="40"
                            Margin="10,0,0,0"
                            Padding="16,0"
                            Command="{Binding TestToneCommand}"
                            Content="播放测试音" />
                    <Button MinWidth="142"
                            Height="40"
                            Margin="10,0,0,0"
                            Padding="16,0"
                            Command="{Binding RecordDebugWaveCommand}"
                            Content="录制 10 秒 WAV" />
                </StackPanel>

                <Grid Grid.Row="4" Margin="0,26,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="Peak" />
                    <ProgressBar Grid.Column="1"
                                 Height="12"
                                 VerticalAlignment="Center"
                                 Maximum="100"
                                 Value="{Binding PeakPercent, Mode=OneWay}" />
                    <TextBlock Grid.Column="2"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{Binding PeakPercent, StringFormat={}{0:F1}%}" />
                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="RMS" />
                    <ProgressBar Grid.Row="1"
                                 Grid.Column="1"
                                 Height="12"
                                 VerticalAlignment="Center"
                                 Maximum="100"
                                 Value="{Binding RmsPercent, Mode=OneWay}" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="2"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{Binding RmsPercent, StringFormat={}{0:F1}%}" />
                </Grid>

                <Border Grid.Row="5"
                        Margin="0,24,0,0"
                        Padding="16"
                        VerticalAlignment="Top"
                        Background="#F7F9FB"
                        CornerRadius="10">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{Binding StatusText}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="#66717D"
                                   Text="{Binding StatisticsText}" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="#7A4650"
                                   Text="{Binding ErrorText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
