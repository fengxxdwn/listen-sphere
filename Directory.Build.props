<Project>
  <Import Project="eng/ListenSphere.Version.props" />
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Version>$(ListenSphereProductVersion)</Version>
    <VersionPrefix>$(ListenSphereVersionPrefix)</VersionPrefix>
    <VersionSuffix>$(ListenSphereVersionSuffix)</VersionSuffix>
    <InformationalVersion>$(ListenSphereProductVersion)</InformationalVersion>
    <Company>ListenSphere Project</Company>
    <Product>ListenSphere</Product>
    <Copyright>Copyright © ListenSphere Project 2026</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
